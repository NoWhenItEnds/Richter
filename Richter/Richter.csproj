<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ahwoo.BRUTAL.Core" Version="2026.10.4" />
    <PackageReference Include="Ahwoo.BRUTAL.Glfw" Version="2026.10.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Richter.Domain\Richter.Domain.csproj" />
    <ProjectReference Include="..\Richter.Json\Richter.Json.csproj" />
    <ProjectReference Include="..\Richter.Vulkan\Richter.Vulkan.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The game's own content, the mod core, read at start-up from next to the executable. -->
    <None Update="Mods\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
