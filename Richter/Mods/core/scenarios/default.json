// The scenario the game starts.
//
// starSystem names a file in star-systems/. startTime is an ISO 8601 date and time; one without
// an offset is UTC. Distances are in km and angles in degrees. A network sits on or above a body
// ("surface", which turns with the body) or on a satellite ("orbit", its elements as at
// startTime), naming the body by its id. Its devices are of the kinds in device-kinds.json, and
// every network also gets a gateway. Links join two networks by id, over a cable (between two
// networks on the ground of one body), radio or laser.
//
// Networks and links have ids so that a mod's copy of this file can replace them or link to
// them. See docs/modding.md.
{
  "starSystem": "solar-system",
  "startTime": "2112-01-01T00:00:00Z",

  "networks": [
    {
      "id": "sydney",
      "name": "Sydney station",
      "surface": { "body": "earth", "latitude": -33.87, "longitude": 151.21, "altitude": 0.05 },
      "devices": [
        { "kind": "workstation", "name": "Operator desk" },
        { "kind": "camera", "name": "Roof camera" },
        { "kind": "door", "name": "Front door" }
      ]
    },
    {
      "id": "london",
      "name": "London office",
      "surface": { "body": "earth", "latitude": 51.51, "longitude": -0.13, "altitude": 0.02 },
      "devices": [
        { "kind": "workstation", "name": "Reception" },
        { "kind": "door", "name": "Server room" }
      ]
    },
    {
      // Geostationary over the Pacific: 42,164 km from Earth's centre, turning with it.
      "id": "pacific-relay",
      "name": "Pacific relay",
      "surface": { "body": "earth", "latitude": 0, "longitude": 160, "altitude": 35793 }
    },
    {
      // About 550 km up, crossing the equator at 53°, like many communication satellites.
      "id": "low-relay",
      "name": "Low relay",
      "orbit": {
        "parent": "earth",
        "plane": "parentEquator",
        "semiMajorAxis": 6921,
        "eccentricity": 0,
        "inclination": 53,
        "longitudeOfAscendingNode": 0,
        "argumentOfPeriapsis": 0,
        "meanAnomaly": 0
      }
    },
    {
      // Tranquility Base, where Apollo 11 landed.
      "id": "tranquility",
      "name": "Tranquility Base",
      "surface": { "body": "moon", "latitude": 0.674, "longitude": 23.473, "altitude": 0 },
      "devices": [
        { "kind": "camera", "name": "Landing site camera" }
      ]
    },
    {
      // Jezero crater, where Perseverance landed.
      "id": "jezero",
      "name": "Jezero base",
      "surface": { "body": "mars", "latitude": 18.445, "longitude": 77.451, "altitude": 0 },
      "devices": [
        { "kind": "workstation", "name": "Lab terminal" },
        { "kind": "door", "name": "Airlock" }
      ]
    },
    {
      // Areostationary, Mars's geostationary: 20,428 km from its centre, over Jezero's longitude.
      "id": "mars-relay",
      "name": "Mars relay",
      "surface": { "body": "mars", "latitude": 0, "longitude": 77.451, "altitude": 17038.5 }
    }
  ],

  "links": [
    { "id": "sydney-london", "between": ["sydney", "london"], "medium": "cable" },
    { "id": "sydney-pacific", "between": ["sydney", "pacific-relay"], "medium": "radio" },
    { "id": "london-low", "between": ["london", "low-relay"], "medium": "radio" },
    { "id": "pacific-low", "between": ["pacific-relay", "low-relay"], "medium": "laser" },
    { "id": "pacific-tranquility", "between": ["pacific-relay", "tranquility"], "medium": "radio" },
    { "id": "sydney-mars", "between": ["sydney", "mars-relay"], "medium": "radio" },
    { "id": "mars-jezero", "between": ["mars-relay", "jezero"], "medium": "radio" }
  ]
}
